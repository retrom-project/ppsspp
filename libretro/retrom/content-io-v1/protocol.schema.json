      "properties": {
        "type": {
          "const": "BOOT"
        },
        "v": {
          "const": 1
        },
        "abi": {
          "const": "content-io-v1"
        },
        "contractSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid"
        },
        "managementChannelId": {
          "type": "string",
          "format": "uuid"
        },
        "managementPort": {
          "description": "Checked by the runtime host-object validator, not by JSON Schema",
          "x-hostObject": "MessagePort"
        },
        "storageOrigin": {
          "type": "string",
          "format": "uri"
        },
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "l1BudgetBytes": {
          "enum": [
            0,
            2097152
          ]
        },
        "l2BudgetBytes": {
          "enum": [
            14680064,
            16777216
          ]
        },
        "fetchPolicy": {
          "$ref": "#/$defs/fetchPolicy"
        },
        "diagnostics": {
          "const": true
        }
