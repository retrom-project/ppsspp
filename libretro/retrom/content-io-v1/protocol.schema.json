{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:retrom:content-io:v1",
  "description": "JSON field shape; opaque host objects and cross-field consistency require runtime validation.",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sizeBytes",
        "url",
        "purpose",
        "transport",
        "etagPolicy",
        "contentLengthPolicy"
      ],
      "properties": {
        "identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sha256"
              ],
              "properties": {
                "kind": {
                  "const": "FILE_SHA256"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "projectDigest",
                "logicalPath"
              ],
              "properties": {
                "kind": {
                  "const": "INDEX_ENTRY"
                },
                "projectDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "logicalPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "purpose": {
          "enum": [
            "GAME",
            "FIRMWARE",
            "CORE_ASSET"
          ]
        },
        "transport": {
          "enum": [
            "RANGE_REQUIRED",
            "WHOLE_ALLOWED"
          ]
        },
        "etagPolicy": {
          "enum": [
            "EXPECTED_SHA256",
            "PIN_STRONG",
            "NONE_FULL_SHA256",
            "IMMUTABLE_ASSET"
          ]
        },
        "contentLengthPolicy": {
          "enum": [
            "EXACT_IF_PRESENT",
            "REQUIRED_EXACT"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "bridge",
        "result",
        "maxFileBytes",
        "workspace",
        "writes",
        "contentLengthPolicy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "RANGE",
            "EAGER",
            "ON_OPEN"
          ]
        },
        "bridge": {
          "enum": [
            "ASYNC",
            "SYNC_WORKER",
            "POLLING",
            "WASMFS",
            "VLFS",
            "NONE"
          ]
        },
        "result": {
          "enum": [
            "READER",
            "BYTES",
            "BLOB",
            "WORKSPACE_FILE"
          ]
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workspace": {
          "enum": [
            "NONE",
            "OPFS_REQUIRED"
          ]
        },
        "writes": {
          "enum": [
            "DENY",
            "SESSION_OVERLAY"
          ]
        },
        "contentLengthPolicy": {
          "enum": [
            "EXACT_IF_PRESENT",
            "REQUIRED_EXACT"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectKey",
        "storageGeneration",
        "sizeBytes",
        "localSha256",
        "assurance",
        "pinnedEtag"
      ],
      "properties": {
        "objectKey": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storageGeneration": {
          "type": "string",
          "format": "uuid"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "localSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "assurance": {
          "enum": [
            "EXPECTED_SHA256",
            "TRUSTED_IMMUTABLE_INDEX"
          ]
        },
        "pinnedEtag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "fetchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smallFileThresholdBytes",
        "networkWindowBytes"
      ],
      "properties": {
        "smallFileThresholdBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "networkWindowBytes": {
          "type": "integer",
          "minimum": 262144,
          "maximum": 2097152,
          "multipleOf": 262144
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "v",
